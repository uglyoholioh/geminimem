function MDVinylPlayer({ currentTrack, isPaused, player }: {
    currentTrack: any
    isPaused: boolean
    player: any
}) {
    const albumArt = currentTrack?.album?.images?.[0]?.url
    const artists = currentTrack?.artists?.map((a: any) => a.name).join(', ') ?? ''
    const titleLong = (currentTrack?.name?.length ?? 0) > 30

    /* Generate groove rings */
    const grooves = useMemo(() =>
        Array.from({ length: 28 }, (_, i) => {
            const pct = 55 + i * 1.55  // from ~55% to ~98%
            const opacity = 0.025 + (i % 4 === 0 ? 0.018 : 0) + (i % 7 === 0 ? 0.012 : 0)
            return { pct, opacity }
        }), [])

    return (
        <div className="flex flex-col items-center w-full select-none">
            <style>{VINYL_STYLES}</style>

            {/* ────── Turntable Surface ────── */}
            <div
                className="relative flex items-center justify-center"
                style={{ width: '340px', height: '320px' }}
            >
                {/* Ambient glow — soft colour wash behind the record */}
                {albumArt && (
                    <div
                        className="absolute pointer-events-none rounded-full"
                        style={{
                            width: '360px',
                            height: '360px',
                            left: '50%',
                            top: '50%',
                            transform: 'translate(-50%, -50%)',
                            background: 'radial-gradient(circle, rgba(240,168,74,0.12) 0%, rgba(240,168,74,0.04) 40%, transparent 70%)',
                            filter: 'blur(30px)',
                            animation: 'vinyl-glow-breathe 5s ease-in-out infinite',
                            zIndex: 0,
                        }}
                    />
                )}

                {/* ──── The Record ──── */}
                <div
                    className={`md-vinyl-disc ${!isPaused ? 'is-spinning' : ''} relative rounded-full cursor-pointer group`}
                    onClick={() => player?.togglePlay()}
                    title={isPaused ? 'Play' : 'Pause'}
                    style={{ width: '290px', height: '290px', zIndex: 2 }}
                >
                    {/* Vinyl body — dark with radial shading */}
                    <div
                        className="absolute inset-0 rounded-full"
                        style={{
                            background: `
                                radial-gradient(circle at 50% 50%,
                                    #2a2a2a 0%,
                                    #1a1a1a 25%,
                                    #111111 48%,
                                    #0a0a0a 49%,
                                    #141414 50%,
                                    #111111 70%,
                                    #0d0d0d 90%,
                                    #080808 100%
                                )
                            `,
                            boxShadow: `
                                0 12px 40px rgba(0,0,0,0.6),
                                0 4px 12px rgba(0,0,0,0.4),
                                inset 0 1px 0 rgba(255,255,255,0.03),
                                inset 0 -1px 0 rgba(0,0,0,0.3)
                            `,
                        }}
                    />


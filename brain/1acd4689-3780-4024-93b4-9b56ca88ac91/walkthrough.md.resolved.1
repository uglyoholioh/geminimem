const VINYL_STYLES = `
/* ── Vinyl spin ── */
@keyframes vinyl-spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
}

/* ── Tonearm ── */
@keyframes needle-settle {
    0%   { transform: rotate(-38deg); }
    70%  { transform: rotate(-16deg); }
    85%  { transform: rotate(-18deg); }
    100% { transform: rotate(-17deg); }
}

/* ── Ambient glow ── */
@keyframes vinyl-glow-breathe {
    0%, 100% { opacity: 0.35; transform: scale(1); }
    50%      { opacity: 0.55; transform: scale(1.06); }
}

/* ── Record ── */
.md-vinyl-disc {
    animation: vinyl-spin 3.6s linear infinite;
    animation-play-state: paused;
    will-change: transform;
    transition: filter 0.4s ease;
}
.md-vinyl-disc.is-spinning {
    animation-play-state: running;
}
.md-vinyl-disc:hover {
    filter: brightness(1.05);
}

/* ── Tonearm ── */
.md-vinyl-arm {
    transform-origin: 78% 6%;
    transform: rotate(-38deg);
    transition: transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
    filter: drop-shadow(2px 4px 6px rgba(0,0,0,0.5));
}
.md-vinyl-arm.is-playing {
    transform: rotate(-17deg);
}

/* ── Track text marquee ── */
@keyframes md-marquee {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
}

function MDVinylPlayer({ currentTrack, isPaused, player }: {
    currentTrack: any
    isPaused: boolean
    player: any
}) {
    const albumArt = currentTrack?.album?.images?.[0]?.url
    const artists = currentTrack?.artists?.map((a: any) => a.name).join(', ') ?? ''
    const titleLong = (currentTrack?.name?.length ?? 0) > 30

    /* Generate groove rings */
    const grooves = useMemo(() =>
        Array.from({ length: 28 }, (_, i) => {
            const pct = 55 + i * 1.55  // from ~55% to ~98%
            const opacity = 0.025 + (i % 4 === 0 ? 0.018 : 0) + (i % 7 === 0 ? 0.012 : 0)
            return { pct, opacity }
        }), [])

    return (
        <div className="flex flex-col items-center w-full select-none">
            <style>{VINYL_STYLES}</style>

            {/* ────── Turntable Surface ────── */}
            <div
                className="relative flex items-center justify-center"
                style={{ width: '340px', height: '320px' }}
            >
                {/* Ambient glow — soft colour wash behind the record */}
                {albumArt && (
                    <div
                        className="absolute pointer-events-none rounded-full"
                        style={{
                            width: '360px',
                            height: '360px',
                            left: '50%',
                            top: '50%',
                            transform: 'translate(-50%, -50%)',
                            background: 'radial-gradient(circle, rgba(240,168,74,0.12) 0%, rgba(240,168,74,0.04) 40%, transparent 70%)',
                            filter: 'blur(30px)',
                            animation: 'vinyl-glow-breathe 5s ease-in-out infinite',
                            zIndex: 0,
                        }}
                    />
                )}

                {/* ──── The Record ──── */}
                <div
                    className={`md-vinyl-disc ${!isPaused ? 'is-spinning' : ''} relative rounded-full cursor-pointer group`}
                    onClick={() => player?.togglePlay()}
                    title={isPaused ? 'Play' : 'Pause'}
                    style={{ width: '290px', height: '290px', zIndex: 2 }}
                >
                    {/* Vinyl body — dark with radial shading */}
                    <div
                        className="absolute inset-0 rounded-full"
                        style={{
                            background: `
                                radial-gradient(circle at 50% 50%,
                                    #2a2a2a 0%,
                                    #1a1a1a 25%,
                                    #111111 48%,
                                    #0a0a0a 49%,
                                    #141414 50%,
                                    #111111 70%,
                                    #0d0d0d 90%,
                                    #080808 100%
                                )
                            `,
                            boxShadow: `
                                0 12px 40px rgba(0,0,0,0.6),
                                0 4px 12px rgba(0,0,0,0.4),
                                inset 0 1px 0 rgba(255,255,255,0.03),
                                inset 0 -1px 0 rgba(0,0,0,0.3)
                            `,
                        }}
                    />

                    {/* Outer rim edge */}
                    <div className="absolute inset-0 rounded-full" style={{
                        border: '1.5px solid rgba(255,255,255,0.04)',
                        background: 'transparent',
                    }} />

                    {/* Grooves — concentric rings */}
                    {grooves.map(({ pct, opacity }, i) => (
                        <div
                            key={i}
                            className="absolute rounded-full pointer-events-none"
                            style={{
                                inset: `${(100 - pct) / 2}%`,
                                border: `0.5px solid rgba(255,255,255,${opacity})`,
                            }}
                        />
                    ))}

                    {/* Album art — large centre label (MD Vinyl style: ~50%) */}
                    <div
                        className="absolute rounded-full overflow-hidden"
                        style={{
                            inset: '24%',
                            boxShadow: `
                                inset 0 0 30px rgba(0,0,0,0.7),
                                0 0 0 2px rgba(0,0,0,0.6),
                                0 0 0 3px rgba(255,255,255,0.04)
                            `,
                        }}
                    >
                        {albumArt ? (
                            <img
                                src={albumArt}
                                alt="Album art"
                                className="w-full h-full object-cover"
                                draggable={false}
                            />
                        ) : (
                            <div className="w-full h-full bg-[#1a1a1a] flex items-center justify-center">
                                <Disc3 className="w-12 h-12 text-white/15" />
                            </div>
                        )}
                    </div>

                    {/* Centre spindle hole */}
                    <div className="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-20"
                        style={{ width: '16px', height: '16px' }}
                    >
                        <div className="w-full h-full rounded-full" style={{
                            background: 'radial-gradient(circle, #222 0%, #0a0a0a 60%, #000 100%)',
                            boxShadow: 'inset 0 1px 3px rgba(0,0,0,0.8), 0 0 0 1px rgba(255,255,255,0.05)',
                        }}>
                            <div className="absolute inset-[3px] rounded-full" style={{
                                background: 'radial-gradient(circle, rgba(240,168,74,0.6) 0%, rgba(200,140,40,0.3) 50%, transparent 100%)',
                            }} />
                        </div>
                    </div>

                    {/* Light reflection — sweeping highlight across the record */}
                    <div className="absolute inset-0 rounded-full pointer-events-none" style={{
                        background: `
                            linear-gradient(
                                145deg,
                                transparent 20%,
                                rgba(255,255,255,0.04) 40%,
                                rgba(255,255,255,0.07) 45%,
                                rgba(255,255,255,0.04) 50%,
                                transparent 65%
                            )
                        `,
                    }} />

                    {/* Hover play/pause indicator */}
                    <div className="absolute inset-0 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-30"
                        style={{ background: 'radial-gradient(circle, rgba(0,0,0,0.35) 0%, transparent 70%)' }}
                    >
                        <div className="w-14 h-14 rounded-full bg-black/50 backdrop-blur-sm border border-white/10 flex items-center justify-center">
                            {isPaused ? (
                                <Play className="w-6 h-6 text-white/90 ml-0.5" fill="currentColor" />
                            ) : (
                                <Pause className="w-6 h-6 text-white/90" fill="currentColor" />
                            )}
                        </div>
                    </div>
                </div>

                {/* ──── Tonearm ──── */}
                <svg
                    className={`md-vinyl-arm ${!isPaused ? 'is-playing' : ''} absolute pointer-events-none`}
                    style={{
                        top: '-30px',
                        right: '-30px',
                        width: '140px',
                        height: '240px',
                        zIndex: 10,
                    }}
                    viewBox="0 0 140 240"
                    fill="none"
                >
                    {/* Pivot housing */}
                    <circle cx="110" cy="14" r="14" fill="#1a1a1a" stroke="#2a2a2a" strokeWidth="1" />
                    <circle cx="110" cy="14" r="8" fill="#222" />
                    <circle cx="110" cy="14" r="3" fill="#333" />

                    {/* Arm — main shaft */}
                    <line x1="108" y1="20" x2="32" y2="180" stroke="url(#armGrad)" strokeWidth="4" strokeLinecap="round" />
                    {/* Arm — highlight edge */}
                    <line x1="109" y1="20" x2="33" y2="180" stroke="rgba(255,255,255,0.08)" strokeWidth="1" strokeLinecap="round" />

                    {/* Headshell */}
                    <path d="M28 176 L18 188 L24 192 L34 180 Z" fill="#2a2a2a" stroke="#3a3a3a" strokeWidth="0.5" />

                    {/* Cartridge */}
                    <rect x="16" y="186" width="10" height="6" rx="1" fill="#333" stroke="#444" strokeWidth="0.5" />

                    {/* Stylus / needle tip */}
                    <line x1="21" y1="192" x2="19" y2="200" stroke="#f0a84a" strokeWidth="1.5" strokeLinecap="round" />
                    <circle cx="19" cy="200" r="1" fill="#f0a84a" opacity="0.8" />

                    {/* Counterweight */}
                    <ellipse cx="126" cy="6" rx="8" ry="5" fill="#222" stroke="#333" strokeWidth="0.5" />

                    <defs>
                        <linearGradient id="armGrad" x1="108" y1="20" x2="32" y2="180">
                            <stop offset="0%" stopColor="#555" />
                            <stop offset="50%" stopColor="#444" />
                            <stop offset="100%" stopColor="#3a3a3a" />
                        </linearGradient>
                    </defs>
                </svg>
            </div>

            {/* ────── Track Info ────── */}
            <div className="flex flex-col items-center gap-1.5 w-full max-w-[300px] mt-3">
                <div className="w-full overflow-hidden whitespace-nowrap text-center">
                    <p
                        className="text-[14px] font-semibold leading-tight"
                        style={{
                            color: 'var(--text-primary)',
                            fontFamily: 'var(--font-sans)',
                            ...(titleLong ? {
                                display: 'inline-block',
                                animation: 'md-marquee 14s linear infinite',
                            } : {})
                        }}
                    >
                        {currentTrack.name}
                        {titleLong && <span style={{ paddingLeft: '3em' }}>{currentTrack.name}</span>}
                    </p>
                </div>
                <p
                    className="text-center truncate max-w-full"
                    style={{
                        fontFamily: 'var(--font-mono)',
                        fontSize: '10px',
                        color: 'var(--text-muted)',
                        textTransform: 'uppercase',
                        letterSpacing: '0.08em',
                    }}
                >
                    {artists}
                </p>
            </div>

            {/* ────── Controls ────── */}
            <div className="flex items-center gap-6 mt-4">
                <button
                    onClick={() => player?.previousTrack()}
                    className="transition-all hover:scale-110 active:scale-90"
                    style={{ color: 'var(--text-muted)' }}
                    onMouseEnter={e => (e.currentTarget.style.color = 'var(--text-primary)')}
                    onMouseLeave={e => (e.currentTarget.style.color = 'var(--text-muted)')}
                    title="Previous"
                >
                    <SkipBack className="w-[18px] h-[18px]" />
                </button>

                <button
                    onClick={() => player?.togglePlay()}
                    className="flex items-center justify-center transition-all hover:scale-105 active:scale-95"
                    title={isPaused ? 'Play' : 'Pause'}
                    style={{
                        width: '48px',
                        height: '48px',
                        borderRadius: '50%',
                        background: isPaused
                            ? 'linear-gradient(135deg, rgba(240,168,74,0.2) 0%, rgba(240,168,74,0.08) 100%)'
                            : 'rgba(255,255,255,0.06)',
                        border: `1px solid ${isPaused ? 'rgba(240,168,74,0.35)' : 'rgba(255,255,255,0.08)'}`,
                        boxShadow: isPaused
                            ? '0 0 24px rgba(240,168,74,0.12), inset 0 1px 0 rgba(255,255,255,0.05)'
                            : 'inset 0 1px 0 rgba(255,255,255,0.03)',
                    }}
                >
                    {isPaused ? (
                        <Play className="w-5 h-5 ml-0.5" style={{ color: '#f0a84a' }} fill="currentColor" />
                    ) : (
                        <Pause className="w-5 h-5" style={{ color: 'var(--text-primary)' }} fill="currentColor" />
                    )}
                </button>

                <button
                    onClick={() => player?.nextTrack()}
                    className="transition-all hover:scale-110 active:scale-90"
                    style={{ color: 'var(--text-muted)' }}
                    onMouseEnter={e => (e.currentTarget.style.color = 'var(--text-primary)')}
                    onMouseLeave={e => (e.currentTarget.style.color = 'var(--text-muted)')}
                    title="Next"
                >
                    <SkipForward className="w-[18px] h-[18px]" />
                </button>
            </div>
        </div>
    )
}

